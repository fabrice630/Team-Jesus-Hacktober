# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=100000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional OpenAI-compatible provider. Leave AI_API_URL empty for the local
# development fallback; no submitted code is executed or persisted.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15
