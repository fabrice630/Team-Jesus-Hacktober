# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BYTES=100000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Gemini API configuration for Google AI Studio
GOOGLE_API_KEY=your_google_api_key_here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
AI_API_KEY=your_google_api_key_here
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=15

# Frontend environment variable
VITE_API_BASE_URL=http://localhost:8000
